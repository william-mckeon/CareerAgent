# =============================================================================
# .env.example  (careeragent-review) — copy to .env and fill in.
# .env is gitignored; only this template is committed.
# =============================================================================

# ----- Inbound auth: the only caller is careeragent-api -----
REVIEW_API_KEY=

# ----- Outbound: careeragent-infra (the model gateway for review subagents) -----
INFRA_URL=http://careeragent-infra:8002
INFRA_API_KEY=

# ----- Outbound: careeragent-github-mcp (read-only repo access, PAT-LESS) -----
# The github-mcp service holds the PAT; this service sends none.
GITHUB_MCP_URL=http://careeragent-github-mcp:8082/mcp

# ----- Outbound: careeragent-dossier (write reviews into the projects library) -----
DOSSIER_URL=http://careeragent-dossier:8006
DOSSIER_API_KEY=

# ----- Harness knobs -----
# MAX_REPOS           — cap the repos reviewed per request
# REVIEW_CONCURRENCY  — parallel per-repo subagents (asyncio.gather semaphore)
# PER_REPO_MAX_STEPS  — tool-loop step cap per repo (bounds each subagent). Set for
#                       a THOROUGH per-repo review (read README + key source, not
#                       just the README), so 24. A repo that still exhausts this
#                       gets ONE salvage turn (a forced submit_review from what was
#                       read) rather than being dropped silently.
# REVIEW_MODEL        — careeragent-infra route: 'base' (default) or 'nervous_system'
# REVIEW_EFFORT       — reasoning_effort per repo: low | medium | high. 'medium' —
#                       the review must be thorough, not a shallow skim (a shallow
#                       low-effort pass also refused to submit on some repos).
MAX_REPOS=12
REVIEW_CONCURRENCY=4
PER_REPO_MAX_STEPS=24
REVIEW_MODEL=base
REVIEW_EFFORT=medium

# LOG_LEVEL=INFO
