# =============================================================================
# .env.example  (careeragent-jobs)
#
# Copy to .env and fill in real values:  cp .env.example .env
# careeragent-jobs runs on port 8011.
# Topology: careeragent-api -> careeragent-jobs (:8011) -> careeragent-review
#           (:8007, the work) + careeragent-sessions (:8005, result injection)
#
# .env is gitignored; only this template is committed.
# =============================================================================

# -----------------------------------------------------------------------------
# JOBS_API_KEY  (inbound — careeragent-api <-> jobs)
# Required on every request except GET /health. careeragent-api's JobsClient
# sends this as its X-API-Key. Generate a strong value:
#   python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
JOBS_API_KEY=replace-with-a-strong-random-key

# -----------------------------------------------------------------------------
# SESSIONS_URL / SESSIONS_API_KEY  (outbound — jobs -> sessions)
# Where the worker INJECTS a finished job's result as an assistant message. The
# key MUST match careeragent-sessions' SESSIONS_API_KEY byte-for-byte.
# -----------------------------------------------------------------------------
SESSIONS_URL=http://careeragent-sessions:8005
SESSIONS_API_KEY=must-match-careeragent-sessions-SESSIONS_API_KEY

# -----------------------------------------------------------------------------
# REVIEW_URL / REVIEW_API_KEY  (outbound — jobs -> review)
# Where the review_repos job runs the repo-review fan-out. The key MUST match
# careeragent-review's inbound REVIEW_API_KEY byte-for-byte.
# -----------------------------------------------------------------------------
REVIEW_URL=http://careeragent-review:8007
REVIEW_API_KEY=must-match-careeragent-review-REVIEW_API_KEY

# -----------------------------------------------------------------------------
# DOSSIER_URL / DOSSIER_API_KEY  (outbound — jobs -> dossier)  [P7 #18b]
# The recurring reminder jobs (follow_up_scan, resume_freshness) READ the
# application tracker here. The key MUST match careeragent-dossier's inbound
# DOSSIER_API_KEY byte-for-byte. Read-only — jobs never mutate the dossier.
# -----------------------------------------------------------------------------
DOSSIER_URL=http://careeragent-dossier:8006
DOSSIER_API_KEY=must-match-careeragent-dossier-DOSSIER_API_KEY

# -----------------------------------------------------------------------------
# CODE_URL / CODE_API_KEY  (outbound — jobs -> careeragent-code)  [Slice E, OPTIONAL]
# The nightly repo_presync job asks careeragent-code to discover + clone/pull the
# user's repos so the first deep review of the day is a warm cache. The key MUST
# match careeragent-code's inbound CODE_API_KEY byte-for-byte. Jobs carries ONLY
# this key — the GitHub PAT stays inside careeragent-code. Leave CODE_API_KEY empty
# to disable the pre-sync (no schedule is seeded).
# -----------------------------------------------------------------------------
CODE_URL=http://careeragent-code:8012
CODE_API_KEY=must-match-careeragent-code-CODE_API_KEY

# -----------------------------------------------------------------------------
# Database (own Postgres by default).
# JOBS_DB_HOST/PORT are set in docker-compose to the bundled jobs-db.
# JOBS_DB_SCHEMA keeps all objects in their own schema so this service can later
# SHARE one Postgres instance with no code change (config-only switch).
# -----------------------------------------------------------------------------
JOBS_DB_USER=careeragent_jobs
JOBS_DB_PASSWORD=
JOBS_DB_HOST=jobs-db
JOBS_DB_PORT=5432
JOBS_DB_NAME=careeragent_jobs
JOBS_DB_SCHEMA=careeragent_jobs
# Optional: a full URL overrides the parts above (postgresql+asyncpg://...).
# JOBS_DATABASE_URL=

# -----------------------------------------------------------------------------
# Worker
# -----------------------------------------------------------------------------
JOBS_WORKER_POLL_SECONDS=2   # how often the worker polls for a pending job
JOBS_MAX_ATTEMPTS=3          # per-job attempt cap before it is marked 'failed'

# -----------------------------------------------------------------------------
# Scheduler (P7 #18b — recurring reminders). The scheduler enqueues a reminder
# job whenever a schedule comes due, targeting a singleton "🔔 Reminders"
# conversation it creates in careeragent-sessions. Cadence is config so it can be
# tuned without a migration (defaults: check every 60s, both scans run daily).
# -----------------------------------------------------------------------------
JOBS_SCHEDULER_ENABLED=true            # set false to disable all recurring reminders
JOBS_SCHEDULER_TICK_SECONDS=60         # how often the scheduler checks for due schedules
JOBS_FOLLOW_UP_INTERVAL_SECONDS=86400  # follow-up-due scan cadence (default: daily)
JOBS_FRESHNESS_INTERVAL_SECONDS=86400  # résumé-freshness scan cadence (default: daily)
JOBS_PRESYNC_INTERVAL_SECONDS=86400    # [Slice E] repo cache-warm cadence (seeded only if CODE_API_KEY set)

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
JOBS_PORT=8011
JOBS_ENABLE_DOCS=false
