# =============================================================================
# .env.example  (careeragent-code) — copy to .env and fill in.
# careeragent-code runs on port 8012. .env is gitignored; only this template is committed.
# =============================================================================

# ----- Inbound auth: the only caller is careeragent-api -----
# careeragent-api's CodeClient sends this as X-API-Key. Generate a strong value:
#   python -c "import secrets; print(secrets.token_hex(32))"
CODE_API_KEY=

# ----- GitHub (outbound clone/fetch) -----
# A READ-ONLY GitHub PAT (Contents: read). Used ONLY to clone/pull over HTTPS; it
# stays in this box and is never returned or logged. Omit for public repos only.
# You can reuse the same read-only PAT as careeragent-github-mcp.
GITHUB_PAT=

# ----- Cache + caps -----
CODE_CACHE_DIR=/cache
CODE_PORT=8012
CODE_GIT_TIMEOUT=120          # per git clone/fetch, seconds
CODE_RG_TIMEOUT=20            # per ripgrep search, seconds
CODE_MAX_FILE_BYTES=400000    # /file cap (bigger files come back truncated)
CODE_MAX_TREE_ENTRIES=4000    # /tree entry cap
CODE_MAX_GREP_MATCHES=200     # /grep match cap
CODE_MAX_CACHE_BYTES=2000000000  # total cache size before LRU eviction (2 GB)
CODE_MAX_REPO_BYTES=500000000    # per-repo ceiling — a bigger repo is refused (413)

# Slice E — nightly warm (POST /refresh): bound the sweep so it never evicts what
# it just warmed. BUDGET_BYTES=0 → default to 85% of CODE_MAX_CACHE_BYTES.
CODE_REFRESH_MAX_REPOS=20
CODE_REFRESH_BUDGET_BYTES=0

# LOG_LEVEL=INFO
