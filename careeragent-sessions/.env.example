# =============================================================================
# .env.example  (careeragent-sessions)
#
# Copy to .env and fill in real values:  cp .env.example .env
# careeragent-sessions runs on port 8005.
# Topology: frontend (:8000) -> careeragent-sessions (:8005) -> careeragent-api (:8001)
#
# .env is gitignored; only this template is committed.
# =============================================================================

# -----------------------------------------------------------------------------
# SESSIONS_API_KEY  (inbound — frontend <-> sessions)
# Required on every request except GET /health. When the frontend is repointed
# at sessions, it sends this as its X-API-Key. Generate a strong value:
#   python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
SESSIONS_API_KEY=replace-with-a-strong-random-key

# -----------------------------------------------------------------------------
# CAREERAGENT_API_URL / CAREERAGENT_API_KEY  (outbound — sessions -> api)
# Where sessions relays /chat, and the key careeragent-api expects. The key MUST
# match careeragent-api's CAREERAGENT_API_KEY byte-for-byte. (On the shared
# Docker network, the URL is the service name.)
# -----------------------------------------------------------------------------
CAREERAGENT_API_URL=http://careeragent-api:8001
CAREERAGENT_API_KEY=must-match-careeragent-api-CAREERAGENT_API_KEY

# -----------------------------------------------------------------------------
# Database (own Postgres by default).
# SESSIONS_DB_HOST/PORT are set in docker-compose to the bundled sessions-db.
# SESSIONS_DB_SCHEMA keeps all objects in their own schema so this service can
# later SHARE one Postgres instance with no code change (config-only switch).
# -----------------------------------------------------------------------------
SESSIONS_DB_USER=careeragent_sessions
SESSIONS_DB_PASSWORD=
SESSIONS_DB_HOST=sessions-db
SESSIONS_DB_PORT=5432
SESSIONS_DB_NAME=careeragent_sessions
SESSIONS_DB_SCHEMA=careeragent_sessions
# Optional: a full URL overrides the parts above (postgresql+asyncpg://...).
# SESSIONS_DATABASE_URL=

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
SESSIONS_PORT=8005
SESSIONS_ENABLE_DOCS=false
