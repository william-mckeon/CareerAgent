# =============================================================================
# .env.example  (careeragent-fetch) — copy to .env and fill in.
# .env is gitignored; only this template is committed.
# =============================================================================

# ----- Inbound auth: the only caller is careeragent-api -----
FETCH_API_KEY=

# ----- Fetch-side limits (POST /fetch) -----
# MAX_FETCH_BYTES — hard cap on the response body, enforced WHILE streaming
#                   (before HTML→text). Over the cap → HTTP 413.
# FETCH_TIMEOUT   — httpx connect+read timeout, seconds.
# MAX_REDIRECTS   — redirects are followed manually and re-validated each hop.
MAX_FETCH_BYTES=2000000
FETCH_TIMEOUT=8
MAX_REDIRECTS=5

# ----- Extract-side limits (POST /extract) -----
# MAX_UPLOAD_BYTES — hard cap on the actual bytes read from the upload → 413.
# MAX_PDF_PAGES    — cap on PDF pages parsed per document.
MAX_UPLOAD_BYTES=10000000
MAX_PDF_PAGES=30

# ----- Shared text cap (both endpoints) -----
# MAX_TEXT_CHARS — returned text is cut here; the response sets truncated=true.
MAX_TEXT_CHARS=100000

# ----- Web search (POST /search) -----
# The provider API key lives ONLY here, so careeragent-api stays credential-less
# (same posture as the GitHub PAT living only in careeragent-github-mcp).
# Get a free Tavily key (1,000 searches/mo, no credit card) at https://tavily.com
# SEARCH_PROVIDER — currently only "tavily".
# TAVILY_API_KEY  — the "tvly-..." key. Web search is disabled (503) until set.
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
SEARCH_TIMEOUT=12
SEARCH_MAX_RESULTS=5

# LOG_LEVEL=INFO
