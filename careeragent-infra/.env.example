# =============================================================================
# .env.example  (project root)
#
# Safe template for .env — committed to the repo.
# Copy this file to .env and fill in real values before running.
#
#   cp .env.example .env
#
# careeragent-infra is the Amazon Bedrock inference proxy. The variable names
# here match the os.environ.get() calls in src/api/main.py and the ENV defaults
# in docker/model/Dockerfile.
#
# careeragent-infra runs on port 8002.
# Port 8001 is reserved for careeragent-api; port 8000 for careeragent-frontend.
# Topology: careeragent-api (:8001) → careeragent-infra (:8002) → Amazon Bedrock
#           Bedrock serves:
#             base model            ← /chat default,  model="base"
#             nervous-system model  ← /chat optional, model="nervous_system"
#             embedding model       ← /embed (EMBEDDING_MODEL)
# =============================================================================

# -----------------------------------------------------------------------------
# API_KEY
# Secret required on every POST /chat and POST /embed request via the
# X-API-Key header. Requests with a missing or incorrect key receive 401.
# careeragent-api — and any other server-side caller — must send this key with
# every request. It is the same value careeragent-api holds as INFRA_API_KEY
# (the names differ across the boundary; the values must match byte-for-byte).
# Use a long random string — at minimum 32 characters.
# Generate: python3 -c "import secrets; print(secrets.token_hex(32))"
# IMPORTANT: never commit your real key — only this placeholder is safe.
# -----------------------------------------------------------------------------
API_KEY=your_api_key_here_minimum_32_characters

# -----------------------------------------------------------------------------
# AWS credentials + region  (used by LiteLLM/boto3 to reach Bedrock)
#
# These authenticate careeragent-infra TO Amazon Bedrock. They replace the old
# provider Bearer key. Supply them however your deployment prefers:
#   - static keys here (simplest for local dev), OR
#   - leave them blank and rely on an attached IAM role / shared AWS profile,
#     in which case only AWS_REGION_NAME is required here.
#
# The IAM principal needs Bedrock model-invocation permissions
# (bedrock:InvokeModel, bedrock:InvokeModelWithResponseStream) for the model
# ids you configure below.
#
# IMPORTANT: never commit real AWS credentials — only placeholders are safe.
# -----------------------------------------------------------------------------
AWS_REGION_NAME=us-east-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
# AWS_SESSION_TOKEN=                 # only for temporary (STS) credentials
#
# Alternatively, a Bedrock long-term API key (a single bearer token, no
# key/secret pair to rotate). If set, leave the access-key/secret pair above
# blank — LiteLLM uses this token instead. AWS_REGION_NAME is still required.
# AWS_BEARER_TOKEN_BEDROCK=your_bedrock_api_key

# -----------------------------------------------------------------------------
# BASE_MODEL
# LiteLLM Bedrock model id for the base (coach) model — the primary reasoning
# model, and the default route for all /chat requests (model="base"). Required.
#
# Use a model you have enabled in your Bedrock account + region. Most current
# Claude models on Bedrock require a cross-region inference profile (the "us."
# prefix) rather than the bare on-demand id. Examples:
#   bedrock/us.anthropic.claude-opus-4-8     (highest quality)
#   bedrock/us.anthropic.claude-sonnet-4-6   (cheaper, strong balance)
# Confirm availability in the AWS Bedrock console for your region first.
# -----------------------------------------------------------------------------
BASE_MODEL=bedrock/us.anthropic.claude-opus-4-8

# -----------------------------------------------------------------------------
# NERVOUS_SYSTEM_MODEL
# LiteLLM Bedrock model id for the nervous-system (control-layer) model — the
# fast, lightweight model for routing, history filtering, and agent decisions.
# Used when model="nervous_system" is passed on /chat.
#
# Optional. If unset, model="nervous_system" requests fail gracefully and the
# pipeline is unbroken (omitting the model field always routes to base).
# Example:
#   bedrock/us.anthropic.claude-haiku-4-5
# -----------------------------------------------------------------------------
NERVOUS_SYSTEM_MODEL=bedrock/us.anthropic.claude-haiku-4-5

# -----------------------------------------------------------------------------
# EMBEDDING_MODEL
# LiteLLM Bedrock model id for the embedding model. Used by POST /embed to turn
# text into vectors (e.g. for resume / conversation retrieval).
#
# Optional. If unset, /embed returns a clear "not configured" error and /chat
# is entirely unaffected.
#
# NOTE: the vector dimensionality must match the pgvector column in
# careeragent-memory. Titan Text Embeddings v2 emits 1024-dim vectors. Examples:
#   bedrock/amazon.titan-embed-text-v2:0     (1024-dim)
#   bedrock/cohere.embed-english-v3          (1024-dim)
# -----------------------------------------------------------------------------
EMBEDDING_MODEL=bedrock/amazon.titan-embed-text-v2:0

# -----------------------------------------------------------------------------
# REASONING_EFFORT
# Default reasoning effort if not set per request. Maps to Claude's extended-
# thinking depth on Bedrock. Applies to both chat models (the embedding model
# does not reason). careeragent-api or any tooling can override per request.
#
# Options:
#   low    — fast responses, minimal thinking
#   medium — balanced (default)
#   high   — deep reasoning, extended thinking
#
# An unrecognized value is coerced to "medium" at startup (with a warning).
# -----------------------------------------------------------------------------
REASONING_EFFORT=medium

# -----------------------------------------------------------------------------
# MAX_TOKENS
# Maximum output tokens per /chat generation. Bedrock's Anthropic models require
# a max-tokens bound; it must exceed the thinking budget at high effort.
# Default 8192.
# -----------------------------------------------------------------------------
MAX_TOKENS=8192

# -----------------------------------------------------------------------------
# REQUEST_TIMEOUT
# Per-request timeout in seconds for Bedrock calls. Bedrock is always-warm (no
# scale-to-zero), so this is a real upper bound, not a cold-start absorber.
# Default 600.
# -----------------------------------------------------------------------------
REQUEST_TIMEOUT=600

# -----------------------------------------------------------------------------
# MODEL_RETRIES / BACKOFF_CAP
# Bedrock throws bursts of transient 503s (ServiceUnavailableError) and 429
# throttles on large requests. The proxy retries transient errors with
# exponential backoff + jitter, capped at BACKOFF_CAP seconds, and fails fast on
# permanent errors (400 / access-denied / context overflow). On /chat, retries
# apply only before the first streamed chunk; /embed retries fully.
# Defaults: 5 retries, 20s cap. Set MODEL_RETRIES=0 to disable retries.
# -----------------------------------------------------------------------------
MODEL_RETRIES=5
BACKOFF_CAP=20

# -----------------------------------------------------------------------------
# INFRA_ENABLE_DOCS
# Set to "true" to expose the interactive API docs (/docs, /redoc) and the
# OpenAPI schema (/openapi.json). Disabled by default — this proxy is an
# internal, server-to-server service. Enable only for local development.
# -----------------------------------------------------------------------------
INFRA_ENABLE_DOCS=
