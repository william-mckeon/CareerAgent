# ============================================================================
# careeragent-api - Environment Template (.env.example)
# ============================================================================
#
# HOW TO USE THIS FILE:
#   1. Copy this file to .env in the same directory:
#        cp .env.example .env
#   2. Fill in the SIX required values below.
#   3. (Optional) Configure the careeragent-memory block in OPTIONAL TUNABLES
#      if you want session-scoped retrieval/ingest. Memory is opt-in and
#      adds NO required values — skip it and the gateway runs exactly as
#      before, forwarding full history.
#   4. Bring the stack up:
#        docker-compose up -d --build
#
# .env IS NEVER COMMITTED. .env.example is. The .gitignore in this repo
# excludes .env explicitly. If you ever see a real key in a commit, treat it
# as compromised and rotate immediately.
#
# KEY GENERATION:
#   The six required values fall into two groups based on which other
#   service's value they must match. Generate them as follows:
#
#   CAREERAGENT_API_KEY and INFRA_API_KEY:
#     python -c "import secrets; print(secrets.token_hex(32))"
#   Each call returns a 64-character hex string with 256 bits of entropy.
#
#   LOGGER_API_KEY and LOGGER_HMAC_SECRET (must match careeragent-logger's
#   .env byte-for-byte — see those sections below):
#     python -c "import secrets; print(secrets.token_urlsafe(48))"
#   careeragent-logger's README documents this generation command, so the
#   value generated there is the one to copy into this file. For each of
#   these two, match the convention used by the service on the OTHER side
#   of the boundary.
#
#   The optional careeragent-memory secret (MEMORY_API_KEY) follows the same
#   "copy from the other side" rule — see its block in OPTIONAL TUNABLES.
# ============================================================================


# ----------------------------------------------------------------------------
# CAREERAGENT_API_KEY — INBOUND SECRET (REQUIRED)
# ----------------------------------------------------------------------------
# Validated by careeragent-api on every /chat and /health request.
# careeragent-frontend MUST send this exact value as the X-API-Key header.
#
# This is the secret that authorises the frontend to talk to careeragent-api.
# It does NOT authorise careeragent-api to talk to careeragent-infra — that's
# INFRA_API_KEY below. It does NOT authorise careeragent-api to talk to
# careeragent-logger — that's LOGGER_API_KEY below. Independent secrets at
# independent boundaries (compartmentalized auth).
#
# careeragent-frontend's .env must contain the SAME value as CAREERAGENT_API_KEY
# (or whatever variable name the frontend uses for its outbound key).
#
# Generate a fresh one for each deployment:
#   python -c "import secrets; print(secrets.token_hex(32))"
CAREERAGENT_API_KEY=


# ----------------------------------------------------------------------------
# INFRA_API_KEY — OUTBOUND SECRET TO careeragent-infra (REQUIRED)
# ----------------------------------------------------------------------------
# Sent by careeragent-api as the X-API-Key header on every call to
# careeragent-infra. MUST match careeragent-infra's API_KEY env var
# byte-for-byte.
#
# This key never leaves careeragent-api's environment. The frontend never sees
# it. careeragent-logger never sees it. If it leaks, only careeragent-api →
# careeragent-infra is compromised; the frontend and logger boundaries stay
# intact.
#
# This is intentionally a different value from CAREERAGENT_API_KEY. Two
# independent secrets give you separate blast radii and independent rotation.
# See the api.py header for the full reasoning, or README's "Security Model"
# section.
#
# Generate a fresh one independent of CAREERAGENT_API_KEY:
#   python -c "import secrets; print(secrets.token_hex(32))"
INFRA_API_KEY=


# ----------------------------------------------------------------------------
# CAREERAGENT_INFRA_URL — UPSTREAM ADDRESS FOR careeragent-infra (REQUIRED)
# ----------------------------------------------------------------------------
# Base URL of the careeragent-infra service. No trailing slash.
#
# Pick the value that matches your deployment topology:
#
#   1. Everything on host (no Docker for careeragent-api or careeragent-infra):
#        CAREERAGENT_INFRA_URL=http://localhost:8002
#
#   2. careeragent-api in Docker, careeragent-infra on host (DEFAULT for dev):
#        CAREERAGENT_INFRA_URL=http://host.docker.internal:8002
#
#   3. careeragent-api and careeragent-infra both in Docker on a shared network
#      (see docker-compose.yml "SHARED NETWORK" notes):
#        CAREERAGENT_INFRA_URL=http://careeragent-infra:8002
#
#   4. External careeragent-infra (cloud / remote host):
#        CAREERAGENT_INFRA_URL=https://infra.your-domain.com
#
# Port 8002 is the port convention for careeragent-infra.
CAREERAGENT_INFRA_URL=http://host.docker.internal:8002


# ----------------------------------------------------------------------------
# LOGGER_URL — UPSTREAM ADDRESS FOR careeragent-logger (REQUIRED)
# ----------------------------------------------------------------------------
# Base URL of the careeragent-logger service. No trailing slash.
#
# careeragent-logger is the capture layer that receives operational events
# (request_received, upstream_call, upstream_error, stream_complete) and full
# conversation captures from careeragent-api. careeragent-api refuses to boot if
# this value is missing (lifespan startup validation).
#
# Pick the value that matches your deployment topology (same four-topology
# shape as CAREERAGENT_INFRA_URL above):
#
#   1. Everything on host (no Docker for careeragent-api or careeragent-logger):
#        LOGGER_URL=http://localhost:8003
#
#   2. careeragent-api in Docker, careeragent-logger on host (DEFAULT for dev —
#      careeragent-logger runs in its own Docker stack on the host and
#      careeragent-api reaches it via the host's port mapping):
#        LOGGER_URL=http://host.docker.internal:8003
#
#   3. careeragent-api and careeragent-logger both in Docker on a shared network
#      (see docker-compose.yml "SHARED NETWORK" notes):
#        LOGGER_URL=http://careeragent-logger:8003
#
#   4. External careeragent-logger (cloud / remote host):
#        LOGGER_URL=https://logger.your-domain.com
#
# Port 8003 is the canonical careeragent-logger port per the port convention
# (8000=frontend, 8001=careeragent-api, 8002=careeragent-infra,
# 8003=careeragent-logger).
LOGGER_URL=http://host.docker.internal:8003


# ----------------------------------------------------------------------------
# LOGGER_API_KEY — TRANSPORT SECRET FOR careeragent-logger (REQUIRED)
# ----------------------------------------------------------------------------
# Sent by careeragent-api as the X-API-Key header on every event POST to
# careeragent-logger. MUST match careeragent-logger's LOGGER_API_KEY env var
# byte-for-byte. If the two values diverge, every event submission returns
# HTTP 401 from careeragent-logger and the event is dropped by careeragent-api's
# fire-and-forget queue (with a WARNING log line per failed event).
#
# Independent of LOGGER_HMAC_SECRET below. The two secrets protect against
# different threats and rotate on independent schedules:
#   - LOGGER_API_KEY rotation: invalidates network access on the
#     careeragent-api → careeragent-logger boundary but does NOT invalidate HMAC
#     signatures stored on existing rows. Safe to rotate frequently with a
#     brief coordinated cutover.
#   - LOGGER_HMAC_SECRET rotation: invalidates payload-integrity verification
#     for existing rows. Plan carefully — see the LOGGER_HMAC_SECRET section
#     below.
#
# This key never leaves careeragent-api's environment. The frontend never sees
# it. careeragent-infra never sees it. If it leaks, only careeragent-api →
# careeragent-logger is compromised; the other boundaries stay intact
# (compartmentalized auth per README's "Security Model" section).
#
# Generation: careeragent-logger's convention is token_urlsafe(48) — copy the
# value FROM careeragent-logger's .env rather than generating a new one here.
# The whole point of "MUST match byte-for-byte" is that careeragent-logger is
# the source of truth for this value.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# (Use that ONLY for fresh generation from scratch; for any existing
# careeragent-logger deployment, copy the existing value from its .env.)
LOGGER_API_KEY=


# ----------------------------------------------------------------------------
# LOGGER_HMAC_SECRET — PAYLOAD-SIGNING SECRET FOR careeragent-logger (REQUIRED)
# ----------------------------------------------------------------------------
# HMAC-SHA256 key used by careeragent-api to sign every event payload before
# submission to careeragent-logger. MUST match careeragent-logger's
# LOGGER_HMAC_SECRET env var byte-for-byte. If the two diverge,
# careeragent-logger returns HTTP 401 ("Invalid HMAC signature") on every event
# and careeragent-api's fire-and-forget queue drops it (with a WARNING log line
# per failed event).
#
# The signature is computed over the canonical string:
#   {request_id}|{client_timestamp}|{event_type}|{source_service}|{session_id}|{user_id}|{payload_hash}
# where payload_hash = sha256(canonical_payload_json) and the three
# attribution fields (source_service, session_id, user_id) serialize as the
# empty string "" when None. client_timestamp is the canonical UTC form
# (microsecond precision, +00:00 offset, e.g. 2026-06-14T01:19:45.003236+00:00).
# Per careeragent-logger DATASHEET §2.1. See src/client/logger.py for the
# byte-for-byte implementation contract (sort_keys=True,
# separators=(",", ":"), default=str, ensure_ascii=False).
#
# IMPORTANT — rotation has long-term implications:
#   The signature is stored on every row in careeragent-logger's database (in
#   the hmac_signature column). This means downstream consumers (auditors,
#   any reader) can re-verify event integrity offline using only
#   LOGGER_HMAC_SECRET — they do not need trust in the original transport
#   call. THIS PROPERTY MAKES THE ROTATION POLICY FOR LOGGER_HMAC_SECRET
#   DIFFERENT FROM LOGGER_API_KEY:
#     - LOGGER_API_KEY rotation: cheap. Invalidates only future wire-level
#       access. Existing rows unaffected.
#     - LOGGER_HMAC_SECRET rotation: expensive. Invalidates the
#       offline-verifiability of EVERY pre-rotation row. Plan carefully and
#       coordinate with any downstream consumers. Typical pattern: never
#       rotate unless the old value is known compromised; for a
#       known-compromised rotation, document the cutover timestamp so
#       downstream consumers know which secret to use for which rows.
#
# Independent of LOGGER_API_KEY above (different value, different threat
# model, different rotation schedule — by design).
#
# Generation: careeragent-logger's convention is token_urlsafe(48). As with
# LOGGER_API_KEY, copy the value FROM careeragent-logger's .env rather than
# generating a new one here. careeragent-logger's repo is the source of truth
# for this value.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# (Fresh generation only; for an existing careeragent-logger deployment, copy
# the existing value from its .env.)
LOGGER_HMAC_SECRET=


# ============================================================================
# OPTIONAL TUNABLES — uncomment to override defaults
# ============================================================================

# ----------------------------------------------------------------------------
# careeragent-memory boundary (OPTIONAL — opt-in, disabled by default)
# ----------------------------------------------------------------------------
# careeragent-memory is the session-scoped retrieval/ingest (RAG) layer. It is
# OPT-IN: careeragent-api enables it ONLY when BOTH MEMORY_URL and
# MEMORY_API_KEY are set. Leave either unset and memory stays off —
# careeragent-api forwards the full conversation history upstream exactly as it
# did before memory existed. Memory is NOT a refuse-to-boot dependency: an
# unreachable or unconfigured careeragent-memory never blocks or fails /chat.
#
# When enabled, careeragent-api:
#   - calls MEMORY_URL/retrieve on the hot path BEFORE assembling the prompt
#     (bounded by MEMORY_RETRIEVE_TIMEOUT, fail-open: any timeout / error /
#     degraded response falls back to "recent turns only" and never delays
#     the stream), then assembles the upstream prompt as
#     [bio] + [retrieved older turns] + [recent N turns] + [current turn];
#   - calls MEMORY_URL/ingest twice AFTER a successful stream (user turn then
#     assistant turn) on a detached background task, off the user's path.
#
# This is a FOURTH independent boundary in the compartmentalized-auth model
# (frontend / infra / logger / memory), with its own secret. Unlike the
# careeragent-logger boundary, there is NO HMAC on the memory boundary today —
# careeragent-memory uses transport-key auth only (X-API-Key). The MemoryClient
# scaffolds signing for a future addition; nothing is signed until
# careeragent-memory defines an HMAC contract.

# ----- MEMORY_URL — base URL of careeragent-memory (no trailing slash) -----
# Same four-topology shape as CAREERAGENT_INFRA_URL / LOGGER_URL above:
#   1. Everything on host:                 http://localhost:8004
#   2. api in Docker, memory on host:      http://host.docker.internal:8004
#   3. both in Docker on shared network:   http://careeragent-memory:8004
#   4. External careeragent-memory:          https://memory.your-domain.com
# Port 8004 is the canonical careeragent-memory port per the port convention
# (8000=frontend, 8001=careeragent-api, 8002=careeragent-infra,
# 8003=careeragent-logger, 8004=careeragent-memory).
# Setting BOTH this and MEMORY_API_KEY is what turns memory on.
# MEMORY_URL=http://host.docker.internal:8004

# ----- MEMORY_API_KEY — TRANSPORT SECRET FOR careeragent-memory -----
# Sent by careeragent-api as the X-API-Key header on every /retrieve and
# /ingest call. MUST match careeragent-memory's MEMORY_API_KEY env var
# byte-for-byte, or every call returns HTTP 401. Independent of every other
# secret (separate blast radius, independent rotation) — do NOT reuse
# CAREERAGENT_API_KEY, INFRA_API_KEY, or LOGGER_API_KEY here.
#
# As with the logger secrets, copy the value FROM careeragent-memory's .env
# rather than minting a new one (careeragent-memory is the source of truth).
# Fresh generation, only if starting from scratch:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
# MEMORY_API_KEY=

# ----- MEMORY_HMAC_SECRET — INTEGRITY SECRET FOR careeragent-memory -----
# Second, independent secret for the api -> memory boundary. careeragent-api signs
# every /ingest and /retrieve request envelope (request_id, client_timestamp,
# operation, source_service, session_id, payload_hash) with HMAC-SHA256 keyed by
# this value; careeragent-memory verifies the signature and a freshness window.
# The same signed-boundary discipline as LOGGER_HMAC_SECRET above — so a leaked
# MEMORY_API_KEY alone cannot forge or tamper memory requests.
#
# MUST match careeragent-memory's MEMORY_HMAC_SECRET byte-for-byte. REQUIRED when
# memory is enabled: if MEMORY_URL + MEMORY_API_KEY are set but this is empty,
# careeragent-api leaves memory DISABLED (with a startup warning) rather than
# sending unsigned requests. Independent of every other secret — do NOT reuse.
# Copy the value FROM careeragent-memory's .env (it is the source of truth), or
# generate one: python -c "import secrets; print(secrets.token_hex(32))"
# MEMORY_HMAC_SECRET=

# ----- MEMORY_SESSION_ID — session scope (stopgap, OPTIONAL) -----
# Scopes retrieve/ingest to one conversation AND populates the session_id
# field on every event emitted to careeragent-logger (previously always null).
# A single static value for now; the frontend will mint per-conversation ids
# later, at which point this moves out of the environment.
#
# If memory is enabled (MEMORY_URL + MEMORY_API_KEY set) but this is left
# empty, retrieve/ingest stay INACTIVE — careeragent-api logs a one-line WARNING
# at startup and forwards full history. Memory does nothing useful without a
# session to scope, so set this when you want the memory path exercised.
# MEMORY_SESSION_ID=dev-session-001

# ----- MEMORY_RECENT_N — recent turns kept verbatim (OPTIONAL) -----
# How many of the most-recent conversation messages are kept verbatim in the
# assembled prompt, ahead of the current user turn. Retrieved older turns are
# deduped against this window (by SHA-256 content hash) so a turn that is both
# recent and relevant is never duplicated. Counted in messages (each user or
# assistant turn = 1).
# Default: 10
# MEMORY_RECENT_N=10

# ----- MEMORY_TOP_K — retrieve result cap (OPTIONAL) -----
# Maximum number of retrieved turns to request per /retrieve. Leave unset to
# omit the field entirely and let careeragent-memory apply its own default
# (MEMORY_TOP_K_DEFAULT, which is 5).
# MEMORY_TOP_K=

# ----- MEMORY_RETRIEVE_TIMEOUT — hot-path retrieve bound (OPTIONAL) -----
# Seconds to wait for careeragent-memory's /retrieve response. Short by design:
# retrieve is on the hot path, so a cold embedder behind memory should fail
# open fast (→ "recent turns only") rather than delay the user's first token.
# Ingest uses a separate, longer timeout internally (it is off the user's
# path) and is not configurable here.
# Default: 5.0
# MEMORY_RETRIEVE_TIMEOUT=5.0


# ----------------------------------------------------------------------------
# careeragent-dossier boundary + the AGENT (OPTIONAL — opt-in, off by default)
# ----------------------------------------------------------------------------
# careeragent-dossier is the career-data store (master profile + application
# tracker). When BOTH DOSSIER_URL and DOSSIER_API_KEY are set, careeragent-api
# runs as the resume-coach AGENT: a tool-calling loop that reads and writes the
# user's profile / resumes / applications in dossier via the model's tool calls.
# Leave either unset and the agent stays OFF — careeragent-api behaves as the
# plain SSE relay it was before (fully backward compatible).
#
# The agent's model calls use careeragent-infra's tool-aware /complete endpoint
# (added to infra separately). Until that endpoint exists, a real /chat with the
# agent enabled reports "couldn't reach the model".

# ----- DOSSIER_URL — base URL of careeragent-dossier (no trailing slash) -----
# Shared Docker network:  http://careeragent-dossier:8006
# DOSSIER_URL=http://careeragent-dossier:8006

# ----- DOSSIER_API_KEY — transport secret for the api -> dossier boundary -----
# MUST match careeragent-dossier's DOSSIER_API_KEY byte-for-byte. Independent of
# every other secret. Copy it FROM careeragent-dossier's .env.
# DOSSIER_API_KEY=

# ----- PERMISSION_MODE — the agent's default write-gate mode (OPTIONAL) -----
#   plan        read-only: critique / advise, never change anything.
#   acceptEdits read + write: build and edit profile / resume / application data.
#   default     writes need approval (behaves read-only until edit is enabled).
#   bypass      everything, including delete (automation only).
# The frontend will pick this per conversation later; this is the fallback.
# Default: acceptEdits
# PERMISSION_MODE=acceptEdits

# ----- AGENT_MAX_STEPS — max tool-loop iterations per turn (OPTIONAL) -----
# A SOFT ceiling (a safety limit, not a task budget). On exhaustion the coach
# runs one final tools-disabled synthesis turn (summarize what it did + what
# remains), never a "tell me more" punt. The loop continues past a plain reply
# while the model's update_plan still has open items, and ends when it calls
# finish_answer.
# NOTE: the ceiling is NOT the anti-spin mechanism — the convergence guard in
# agent/loop.py (READ_STREAK_CAP) nudges the model to act/finish after several
# reads with no write or plan progress, so a healthy turn ends well under this.
# Keep at the spec default (40); a lower value just truncates legitimate
# multi-step tasks. (Deploys ran at 20 during early P3 — reconciled to 40.)
# Default: 40
# AGENT_MAX_STEPS=40

# ----- GROUNDING_GATE_ENABLED — block unbacked resume claims (OPTIONAL) -----
# Phase 3 slice 3. When on (default), a drafted resume is checked against the
# user's dossier (master profile + projects) before it ships: any SKILL or DOMAIN
# EXPERIENCE the dossier doesn't back is a phantom — the model is re-prompted to
# remove it or mark it a gap (bounded by GROUNDING_CHALLENGE_CAP in agent/loop.py).
# Only resume-like drafts are checked, so ordinary chat replies are untouched.
# Set to 0/false/no/off to disable (kill-switch if it ever misfires).
# Default: true
# GROUNDING_GATE_ENABLED=true

# ----- Guardian verifier (Phase 3 slice 4, ADR-007) — OPTIONAL -----
# A SEPARATE, fail-closed model call that escalates the deterministic grounding
# gate: it catches the semantic claims a vocabulary can't — proportionality
# ("deep expertise" from 20% of one repo), cross-turn requirement bleed, and
# invented employers/degrees/certifications/dates. Runs only on a resume-like
# final that already passed Tier-1, so ~one extra low-effort call per resume.
# Fail-closed: a timeout / empty / unparseable verdict resolves to BLOCK (the
# resume ships with the claims flagged to the user, never silently passed).
#   GUARDIAN_ENABLED     — 0/false/no/off to disable. Default: true
#   VERIFY_EFFORT        — reasoning_effort for the verifier call: low|medium|high.
#                          Default low (a verdict is a judgment, not generation).
#   VERIFY_MAX_RETRIES   — re-asks if the verdict is unparseable, then fails closed.
#                          Default 1.
# GUARDIAN_ENABLED=true
# VERIFY_EFFORT=low
# VERIFY_MAX_RETRIES=1

# ----- P6 #8: subagent delegation (spawn_subagent) — OPTIONAL -----
# The coach can delegate a narrow subtask to a READ-ONLY helper (bullet-critic,
# jd-gap-analyzer, company-researcher, reviewer) that works in its own clean
# context and returns text. Read-only by construction, so it can never launder a
# write claim or pause the turn. Bounded by depth (1 = coach->worker only), fan-out
# per turn, per-child steps, and a fixed cheap effort (children never inherit the
# request's effort). Set SUBAGENT_ENABLED=false to remove the tool entirely.
# SUBAGENT_ENABLED=true
# SUBAGENT_MAX_DEPTH=1
# SUBAGENT_MAX_FANOUT=3
# SUBAGENT_MAX_STEPS=10
# SUBAGENT_EFFORT=low

# ----- P6 #11: context compaction — OPTIONAL -----
# When a long turn's estimated prompt tokens exceed COMPACT_TOKEN_THRESHOLD, the
# oldest turns are summarized (a cheap tools-disabled call) and dropped, keeping the
# recent window + the plan + the verified-completion ledger. Threshold-gated (never
# a per-step call) and fail-soft (a summarizer failure leaves the convo intact). The
# ledger is never touched, so a summary can't launder an unverified "completed".
# COMPACTION_ENABLED=true
# COMPACT_TOKEN_THRESHOLD=60000
# COMPACT_KEEP_RECENT=8
# COMPACT_EFFORT=low

# ----------------------------------------------------------------------------
# GitHub MCP (OPTIONAL — repo review, opt-in)
# ----------------------------------------------------------------------------
# When GITHUB_MCP_URL is set, careeragent-api connects to a GitHub MCP server
# over streamable HTTP and the coach gains repo-review tools (mcp__github__*) so
# it can read the user's repos and turn them into projects. Fail-soft: a GitHub
# outage or bad config is logged and the coach runs with its dossier tools only.
#
# RECOMMENDED TOPOLOGY (credential-isolated): run the careeragent-github-mcp
# service, which holds the READ-ONLY PAT, and point the api at it PAT-LESS. The
# GitHub token then lives ONLY in careeragent-github-mcp/.env — never here.

# ----- GITHUB_MCP_URL — the MCP server endpoint. Setting it turns MCP ON. -----
# Self-hosted (recommended — api stays PAT-less):
#   GITHUB_MCP_URL=http://careeragent-github-mcp:8082/mcp
# Direct to GitHub's hosted server (then you MUST also set GITHUB_PAT below):
#   GITHUB_MCP_URL=https://api.githubcopilot.com/mcp/
# GITHUB_MCP_URL=http://careeragent-github-mcp:8082/mcp

# ----- GITHUB_PAT — bearer token, ONLY for the hosted-endpoint topology -----
# Leave EMPTY when using careeragent-github-mcp (that service holds the token).
# Only set this if GITHUB_MCP_URL points directly at GitHub's hosted server, in
# which case use a READ-ONLY fine-grained token (Contents + Metadata: Read-only).
# GITHUB_PAT=

# ----- MCP_READ_ONLY — client-side write-tool filter (OPTIONAL) -----
# Defense-in-depth on top of the server's --read-only. Default true.
# MCP_READ_ONLY=true

# ----------------------------------------------------------------------------
# careeragent-review (OPTIONAL) — bulk GitHub repo review
# ----------------------------------------------------------------------------
# When both are set (and the agent is on), the coach gains a `review_repos` tool
# that delegates to careeragent-review: one bounded reviewer per repo, each filed
# as a project in the evidence library. Fail-soft if the service is down.
# REVIEW_URL=http://careeragent-review:8007
# REVIEW_API_KEY=

# ----------------------------------------------------------------------------
# careeragent-fetch (OPTIONAL) — P5 reach: fetch a job posting from its URL
# ----------------------------------------------------------------------------
# When both are set (and the agent is on), the coach gains a READ-ONLY `fetch_url`
# tool that delegates to careeragent-fetch: one SSRF-guarded, size/time-capped GET
# that returns a page's main text so the coach can read a JD from its link instead
# of asking the user to paste it. ALL egress + SSRF defense lives in
# careeragent-fetch — the api never fetches a user URL itself. Fail-soft: if unset
# or unreachable, the coach simply can't fetch a URL (it asks for a paste instead).
# The key must MATCH careeragent-fetch's FETCH_API_KEY byte-for-byte.
#   Shared Docker network:  http://careeragent-fetch:8008
# FETCH_URL=http://careeragent-fetch:8008
# FETCH_API_KEY=

# ----------------------------------------------------------------------------
# careeragent-ats (OPTIONAL) — artifacts: ATS keyword coverage (P7 #16)
# ----------------------------------------------------------------------------
# When both are set (and the agent is on), the coach gains a READ-ONLY `ats_score`
# tool that delegates to careeragent-ats: a deterministic JD-keyword-coverage
# check over an application's SAVED résumé + JD (no model, no DB, no egress).
# Fail-soft: if unset or unreachable, the coach reviews the JD manually instead.
# The key must MATCH careeragent-ats's ATS_API_KEY byte-for-byte.
#   Shared Docker network:  http://careeragent-ats:8010
# ATS_URL=http://careeragent-ats:8010
# ATS_API_KEY=

# ----------------------------------------------------------------------------
# careeragent-render (OPTIONAL) — artifacts: render résumé PDF/DOCX (P7 #16)
# ----------------------------------------------------------------------------
# When both are set (and the agent is on), the coach gains a `render_resume` WRITE
# tool that delegates to careeragent-render (markdown résumé -> PDF/DOCX bytes),
# stores the bytes in careeragent-dossier, and shows the user a download button.
# Fail-soft: if unset or unreachable, the coach simply can't render a document.
# The key must MATCH careeragent-render's RENDER_API_KEY byte-for-byte.
#   Shared Docker network:  http://careeragent-render:8009
# RENDER_URL=http://careeragent-render:8009
# RENDER_API_KEY=

# ----------------------------------------------------------------------------
# careeragent-jobs (OPTIONAL) — background/async jobs (P7 #18)
# ----------------------------------------------------------------------------
# When both are set (and the agent is on), the coach gains a `spawn_job` control
# tool that enqueues a SLOW task (e.g. a repo review) to careeragent-jobs and
# returns immediately; the jobs worker runs it and injects the result back into the
# conversation ("do not poll"). Fail-soft: if unset/unreachable, the coach does the
# task inline. The key must MATCH careeragent-jobs's JOBS_API_KEY byte-for-byte.
#   Shared Docker network:  http://careeragent-jobs:8011
# JOBS_URL=http://careeragent-jobs:8011
# JOBS_API_KEY=

# ----------------------------------------------------------------------------
# careeragent-sessions callback (OPTIONAL) — P4.5 mid-run steering / interrupt
# ----------------------------------------------------------------------------
# When both are set, the coach polls careeragent-sessions between steps to drain
# any steering message / interrupt the user posted while a turn is running. The
# key must MATCH careeragent-sessions' SESSIONS_API_KEY. Fail-open: if unset or
# unreachable, the coach just can't be steered mid-run — everything else works.
# SESSIONS_URL=http://careeragent-sessions:8005
# SESSIONS_API_KEY=


# ----------------------------------------------------------------------------
# CAREERAGENT_FRONTEND_URL — extra CORS origin (OPTIONAL)
# ----------------------------------------------------------------------------
# Adds an additional allowed origin to the CORS middleware. Use this when
# careeragent-frontend is deployed at a custom domain (Render, Fly, Cloudflare,
# etc.) that isn't already in the built-in origin list. Empty / unset means
# "use built-in origins only" (localhost variants and the careeragent-frontend
# Docker service name).
# CAREERAGENT_FRONTEND_URL=https://careeragent.your-domain.com


# ----------------------------------------------------------------------------
# CAREERAGENT_LOG_LEVEL — log verbosity (OPTIONAL)
# ----------------------------------------------------------------------------
# One of: DEBUG | INFO | WARNING | ERROR | CRITICAL
# Default: INFO
# DEBUG is noisy — emits per-request detail. Use for development only. DEBUG
# also enables per-event LoggerClient drain success messages; expect roughly
# 4-5 additional DEBUG lines per /chat call when set to DEBUG.
# CAREERAGENT_LOG_LEVEL=INFO


# ----------------------------------------------------------------------------
# CAREERAGENT_UPSTREAM_CONNECT_TIMEOUT — TCP connect timeout (OPTIONAL)
# ----------------------------------------------------------------------------
# Seconds to wait for the TCP connection to careeragent-infra. Short by design
# — if careeragent-infra is unreachable, fail fast.
# Default: 10.0
# Note: this controls the careeragent-infra boundary only. The careeragent-logger
# boundary has its own connect timeout (5s) hard-coded in
# src/client/logger.py because fire-and-forget emissions should fail even
# faster than the hot-path stream. The careeragent-memory boundary likewise has
# its own connect timeout (5s) inside src/client/memory.py.
# CAREERAGENT_UPSTREAM_CONNECT_TIMEOUT=10.0


# ----------------------------------------------------------------------------
# CAREERAGENT_UPSTREAM_READ_TIMEOUT — read timeout during streaming (OPTIONAL)
# ----------------------------------------------------------------------------
# Seconds to wait for the next chunk from careeragent-infra during a stream.
# Default is unbounded ("none") because two distinct upstream conditions can
# legitimately take many minutes:
#   1. Provider cold-start. A scale-to-zero serverless worker spins down when
#      idle. The first request after a period of inactivity waits for the
#      worker to spin up before any token can stream back.
#   2. High-effort reasoning generation. At reasoning_effort=high the model
#      can think for 1-3 minutes before producing visible output (per
#      careeragent-infra's datasheet generation timing table).
# Setting a finite value would kill either of these legitimate waits.
# Accepted values: a number (e.g. "300") or "none" / "null" / "" for
# unbounded.
# CAREERAGENT_UPSTREAM_READ_TIMEOUT=none


# ----------------------------------------------------------------------------
# CAREERAGENT_HEALTH_TIMEOUT — upstream /health probe timeout (OPTIONAL)
# ----------------------------------------------------------------------------
# Seconds to wait for careeragent-infra's /health response. Short because the
# frontend polls /health every 3 seconds and must never block.
# Default: 5.0
# CAREERAGENT_HEALTH_TIMEOUT=5.0

# ----------------------------------------------------------------------------
# CAREERAGENT_MODEL_MAX_RETRIES / _BACKOFF_BASE / _BACKOFF_CAP (OPTIONAL, P2)
# ----------------------------------------------------------------------------
# Bounded retry for the non-streaming /complete call (the agent tool loop): a
# Bedrock throttle (429) / transient 5xx / transport blip is retried with
# exponential backoff + jitter (honoring Retry-After) instead of dead-ending the
# turn. careeragent-infra already retries the model call, so keep this MODEST —
# it only rides out the api<->infra hop + infra 5xx. Set MAX_RETRIES=0 to disable.
# Defaults: 3 attempts, 0.5s base, 8.0s cap.
# CAREERAGENT_MODEL_MAX_RETRIES=3
# CAREERAGENT_MODEL_BACKOFF_BASE=0.5
# CAREERAGENT_MODEL_BACKOFF_CAP=8.0


# ----------------------------------------------------------------------------
# CAREERAGENT_BIO_PATH — override bio.txt path (OPTIONAL)
# ----------------------------------------------------------------------------
# Path inside the container to the persona file. Override only if you mount
# bio.txt from a volume rather than baking it into the image.
# Default: /app/src/prompt/bio.txt
# CAREERAGENT_BIO_PATH=/app/src/prompt/bio.txt


# ----------------------------------------------------------------------------
# CAREERAGENT_LOGGER_QUEUE_MAX_SIZE — LoggerClient queue capacity (OPTIONAL)
# ----------------------------------------------------------------------------
# Maximum pending events in careeragent-api's LoggerClient queue before the
# drop-oldest overflow policy kicks in. The queue is in-process, in-memory;
# it does not persist across restarts. When the queue is full, the oldest
# pending event is evicted with a WARNING log line to make room for the new
# event.
#
# When to raise this: you anticipate longer sustained careeragent-logger
# outages and want to retain more pending events in memory until the capture
# layer comes back.
# When to lower this: memory is tight on the container; you prefer to
# fail-faster on event loss with louder warnings.
#
# Default: 1000
#
# Memory cost is roughly proportional to queue size × average event size.
# Typical events are a few KB (small ops_event); the largest possible event
# is a ~1 MB conversation_capture (output_text capped at 1_000_000 chars per
# careeragent-logger DATASHEET §2.1). 1000 events at average size is well under
# 100 MB; worst-case all-large 1000-event queue is ~1 GB, which is far more
# than careeragent-api typically consumes in normal operation.
#
# This is an careeragent-api-side operational tunable. It does NOT need to match
# anything in careeragent-logger's .env — careeragent-logger has no corresponding
# setting.
# CAREERAGENT_LOGGER_QUEUE_MAX_SIZE=1000
