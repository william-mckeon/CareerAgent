# =============================================================================
# .env.example  (careeragent-dossier)
#
# Copy to .env and fill in real values:  cp .env.example .env
# careeragent-dossier runs on port 8006. Its ONLY client is careeragent-api.
#
# .env is gitignored; only this template is committed.
# =============================================================================

# -----------------------------------------------------------------------------
# DOSSIER_API_KEY  (inbound — careeragent-api <-> dossier)
# Required on every request except GET /health. careeragent-api sends this as its
# X-API-Key on every tool call. Generate a strong value:
#   python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
DOSSIER_API_KEY=replace-with-a-strong-random-key

# -----------------------------------------------------------------------------
# Database (own Postgres by default).
# DOSSIER_DB_HOST/PORT are set in docker-compose to the bundled dossier-db.
# DOSSIER_DB_SCHEMA keeps all objects in their own schema so this service can
# later SHARE one Postgres instance with no code change (config-only switch).
# -----------------------------------------------------------------------------
DOSSIER_DB_USER=careeragent_dossier
DOSSIER_DB_PASSWORD=
DOSSIER_DB_HOST=dossier-db
DOSSIER_DB_PORT=5432
DOSSIER_DB_NAME=careeragent_dossier
DOSSIER_DB_SCHEMA=careeragent_dossier
# Optional: a full URL overrides the parts above (postgresql+asyncpg://...).
# DOSSIER_DATABASE_URL=

# -----------------------------------------------------------------------------
# Misc
# -----------------------------------------------------------------------------
DOSSIER_PORT=8006
DOSSIER_ENABLE_DOCS=false
