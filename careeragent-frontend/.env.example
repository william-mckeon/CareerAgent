# ============================================================================
# careeragent-frontend - Environment Template (.env.example)
# ============================================================================
#
# ROLE:
#   Template for the runtime .env file. Copy this to .env and fill in the real
#   values. This file is committed to the repo as a reference for the
#   variables that careeragent-frontend reads at startup; .env itself is
#   gitignored and never committed.
#
#   Workflow:
#     cp .env.example .env
#     # Edit .env: set CAREERAGENT_API_KEY, possibly adjust CAREERAGENT_API_URL
#     docker-compose up -d --build
#
# WHAT TALKS TO WHAT:
#   The frontend talks to careeragent-api ONLY. careeragent-api owns the persona,
#   the auth boundary to careeragent-infra, and the SSE relay. The frontend has
#   no knowledge of careeragent-infra or the compute provider and never sees
#   their auth credentials.
#
#     Browser
#       │
#       │ http://localhost:8000
#       ▼
#     careeragent-frontend     ← THIS REPO
#       │
#       │ X-API-Key: CAREERAGENT_API_KEY   ← variable defined HERE
#       │ Target:    CAREERAGENT_API_URL   ← variable defined HERE
#       ▼
#     careeragent-api          (separate repo)
#       │
#       │ X-API-Key: INFRA_API_KEY        ← variable defined in careeragent-api/.env
#       │ Target:    CAREERAGENT_INFRA_URL  ← variable defined in careeragent-api/.env
#       ▼
#     careeragent-infra        (separate repo)
#       │
#       │ Authorization: Bearer PROVIDER_API_KEY  ← in careeragent-infra/.env
#       ▼
#     BYOC compute provider
#
#   Three independent secrets at three independent boundaries. This file only
#   carries the first one (CAREERAGENT_API_KEY).
# ============================================================================


# ----------------------------------------------------------------------------
# CAREERAGENT_API_URL
# ----------------------------------------------------------------------------
# Base URL of the careeragent-api gateway service. No trailing slash —
# careeragent-frontend's app.py rstrip()'s defensively, but a clean value here
# makes log lines readable.
#
# Pick the form that matches your deployment topology:
#
#   Local dev, both careeragent-frontend and careeragent-api on host (no Docker):
#     CAREERAGENT_API_URL=http://localhost:8001
#
#   Local dev, careeragent-frontend in Docker, careeragent-api on host (RECOMMENDED):
#     CAREERAGENT_API_URL=http://host.docker.internal:8001
#
#   Both careeragent-frontend and careeragent-api in Docker on shared external network:
#     CAREERAGENT_API_URL=http://careeragent-api:8001
#
#   External / production deployment:
#     CAREERAGENT_API_URL=https://api.your-domain.com
#
# Port 8001 is careeragent-api's port. The frontend never talks to
# careeragent-infra directly.
CAREERAGENT_API_URL=http://host.docker.internal:8001


# ----------------------------------------------------------------------------
# CAREERAGENT_API_KEY
# ----------------------------------------------------------------------------
# Shared secret sent on every POST /chat and GET /health call to careeragent-api
# via the X-API-Key header. MUST match CAREERAGENT_API_KEY in careeragent-api's
# .env file exactly.
#
# This is the FRONTEND ↔ CAREERAGENT-API boundary key only. It is NOT the same
# as the keys at the other two boundaries:
#
#   Boundary                          Key                Lives in
#   --------                          ---                --------
#   frontend ↔ careeragent-api          CAREERAGENT_API_KEY  careeragent-frontend/.env  ← THIS FILE
#                                                        careeragent-api/.env
#
#   careeragent-api ↔ careeragent-infra   INFRA_API_KEY      careeragent-api/.env
#                                                        careeragent-infra/.env
#
#   careeragent-infra ↔ provider        PROVIDER_API_KEY   careeragent-infra/.env
#
# Each pair of services has its own shared secret. No key is forwarded
# unchanged through the chain. This is "compartmentalization" / the principle
# of least privilege applied to credentials — see careeragent-api's security
# model documentation for the full rationale and the rotation procedure.
#
# Generate a fresh value with:
#   python -c "import secrets; print(secrets.token_hex(32))"
#
# This returns a 64-character hex string (256 bits of entropy from the OS
# RNG). Do not use UUIDs, timestamps, hand-typed strings, or anything
# human-derived.
#
# NEVER reuse this value as INFRA_API_KEY or PROVIDER_API_KEY, even
# temporarily during testing. Each key must be independently generated.
#
# Replace the placeholder below before first run.
CAREERAGENT_API_KEY=replace_with_a_long_random_secret_key_minimum_32_characters


# ----------------------------------------------------------------------------
# FETCH_URL / FETCH_API_KEY  (OPTIONAL — P5 resume upload)
# ----------------------------------------------------------------------------
# When BOTH are set, the UI shows a "📎 Upload a resume (PDF or DOCX)" widget.
# The frontend POSTs the file DIRECTLY to careeragent-fetch's /extract endpoint
# (a separate hop from /chat — the file bytes never ride the chat relay), gets
# back extracted text, and seeds a normal chat turn with it so the coach can
# read it into your master profile. Leave either unset and the widget is simply
# hidden; everything else works unchanged.
#
# This is a FOURTH boundary key: frontend ↔ careeragent-fetch. It MUST match
# careeragent-fetch's FETCH_API_KEY byte-for-byte, and must NOT reuse
# CAREERAGENT_API_KEY. careeragent-fetch owns all SSRF/file-safety limits.
#
#   Shared Docker network:            http://careeragent-fetch:8008
#   frontend in Docker, fetch on host: http://host.docker.internal:8008
# FETCH_URL=http://careeragent-fetch:8008
# FETCH_API_KEY=

# ----- MAX_UPLOAD_MB — reject an over-size file before sending (OPTIONAL) -----
# A pre-send guard in the frontend; careeragent-fetch enforces its own hard cap
# too, and Streamlit's own --server.maxUploadSize (10 MB, set in the Dockerfile)
# rejects even larger files at the widget. Keep these three in rough agreement.
# Default: 10
# MAX_UPLOAD_MB=10


# ============================================================================
# END OF TEMPLATE
# ============================================================================
