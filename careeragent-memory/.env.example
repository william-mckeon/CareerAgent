# careeragent-memory — environment template. Copy to .env and fill in.
# .env is gitignored and must never be committed.

# --- inbound auth (api -> memory) ---
# Two independent secrets gate this boundary (compartmentalized, like the logger).
#
# 1. Transport key — careeragent-api sends it as X-API-Key on /retrieve, /ingest,
#    /health. Generate: python -c "import secrets; print(secrets.token_hex(32))"
MEMORY_API_KEY=
#
# 2. HMAC integrity secret — careeragent-api signs each /ingest and /retrieve
#    request envelope with this; memory verifies the signature and a freshness
#    window. MUST match careeragent-api's MEMORY_HMAC_SECRET byte-for-byte.
#    Generate: python -c "import secrets; print(secrets.token_hex(32))"
MEMORY_HMAC_SECRET=
#
# Optional: replay-window tolerance in seconds for the signed client_timestamp
# (default 300). Requests outside this skew vs server time are rejected.
# MEMORY_REPLAY_WINDOW_SECONDS=300

# --- outbound auth (memory -> careeragent-infra /embed) ---
# MUST match careeragent-infra's API_KEY byte-for-byte (the same value careeragent-api
# holds as INFRA_API_KEY). careeragent-infra shares one caller key today.
INFRA_API_KEY=

# Base URL of careeragent-infra (no trailing slash). On the shared network use the
# container name; standalone use http://host.docker.internal:8002.
CAREERAGENT_INFRA_URL=http://careeragent-infra:8002

# --- memory's OWN database (Postgres + pgvector) ---
# Either set MEMORY_DATABASE_URL directly (preferred), or leave it blank and let
# the components below assemble it. These same values configure the memory-db
# container in docker-compose, so they are the single source of truth.
# MEMORY_DATABASE_URL=postgresql+psycopg://careeragent_memory:CHANGEME@memory-db:5432/careeragent_memory
MEMORY_DB_USER=careeragent_memory
MEMORY_DB_PASSWORD=
MEMORY_DB_HOST=memory-db
MEMORY_DB_PORT=5432
MEMORY_DB_NAME=careeragent_memory

# --- retrieval behaviour ---
MEMORY_TOP_K_DEFAULT=5
MEMORY_MIN_SCORE=0.0

# --- embedding call timeouts (seconds) ---
# Read timeout bounds how long retrieval waits before failing open on a cold embedder.
MEMORY_EMBED_TIMEOUT=10.0
MEMORY_EMBED_CONNECT_TIMEOUT=5.0

# --- misc ---
MEMORY_PORT=8004
MEMORY_LOG_LEVEL=INFO
