# =============================================================================
# .env.example  (careeragent-render) — copy to .env and fill in.
# .env is gitignored; only this template is committed.
# =============================================================================

# ----- Inbound auth: the only caller is careeragent-api -----
RENDER_API_KEY=

# ----- Input size cap (POST /render) -----
# MAX_RESUME_BYTES — max résumé markdown accepted, on ACTUAL UTF-8 bytes.
#                    Over the cap → HTTP 413 (rejected before any layout).
MAX_RESUME_BYTES=200000

# LOG_LEVEL=INFO
